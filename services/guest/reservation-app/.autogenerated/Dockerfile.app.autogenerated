# ---- L1: os_base (Golden L1: flisk-restaurant-example-l1:latest) ----
FROM flisk-restaurant-example-l1:latest AS l1_os_base
# OS dependencies pre-installed in golden L1 image
WORKDIR /app


# ---- L1: runtime_env ----
# Shared runtime environment
ENV NODE_ENV=production
ENV BUN_INSTALL_CACHE_DIR=/cache/bun


# ---- L2: dependency_manifest ----
FROM flisk-restaurant-example-l2:latest AS l2_deps_manifest
WORKDIR /app

# Cache-busting mechanism - change this value to force dependency reinstall
ARG CACHE_BUSTER=2026-06-25-v1
RUN echo "Cache buster: ${CACHE_BUSTER}"


# Copy workspace root for monorepo resolution
COPY package.json ./package.json
COPY services/guest/reservation-app/.autogenerated/.npmrc.docker.autogenerated /app/.npmrc
COPY services/guest/reservation-app/.autogenerated/bunfig.docker.autogenerated.toml /app/.bunfig.toml

# Copy service manifest files for deterministic dependency layer
WORKDIR /app/services/guest/reservation-app
COPY services/guest/reservation-app/package.json ./package.json
COPY services/guest/reservation-app/.autogenerated/.npmrc.docker.autogenerated .npmrc
COPY bun.lock* ./
COPY services/guest/reservation-app/.autogenerated/bunfig.docker.autogenerated.toml .bunfig.toml

# Diagnostics suppressed (set TILT_DEBUG=true for verbose output)
# Install dependencies (quiet by default; set TILT_DEBUG=true for verbose diagnostics)
COPY shared-platform-engineering/docker-templates/install-deps.sh /usr/local/bin/install-deps.sh
RUN --mount=type=cache,target=/cache/bun,sharing=shared chmod +x /usr/local/bin/install-deps.sh && start_ts=$(date +%s) && /usr/local/bin/install-deps.sh && end_ts=$(date +%s) && echo "install-deps duration: $((end_ts-start_ts))s"
RUN mkdir -p /app/node_modules/.bun


# ---- L3: frontend_builder ----
FROM flisk-restaurant-example-l3-frontend:latest AS l3_frontend_build
WORKDIR /app/services/guest/reservation-app
# Build argument to skip Infisical setup (for local dev / fast builds)
ARG SKIP_INFISICAL_SETUP=1
# Reuse resolved dependencies from l2_deps_manifest to avoid reinstalling in L3
COPY --link --from=l2_deps_manifest /app/services/guest/reservation-app/node_modules ./node_modules
COPY --link --from=l2_deps_manifest /app/node_modules/.bun /app/node_modules/.bun
# Copy manifest files required by the build
COPY services/guest/reservation-app/package.json ./package.json
COPY services/guest/reservation-app/.autogenerated/bunfig.docker.autogenerated.toml ./bunfig.toml
COPY services/guest/reservation-app/.autogenerated/tsconfig.docker.autogenerated.json ./tsconfig.json
COPY services/guest/reservation-app/.autogenerated/tsconfig.autogenerated.json ./.autogenerated/tsconfig.autogenerated.json
COPY services/guest/reservation-app/.autogenerated/*.ts ./.autogenerated/
COPY services/guest/reservation-app/src ./src
COPY services/guest/reservation-app/public ./public
COPY services/guest/reservation-app/index.html ./index.html
ENV NODE_ENV=production
RUN bun run build --config .autogenerated/vite.config.build.autogenerated.ts


# ---- L4: frontend_runtime (nginx) ----
FROM flisk-restaurant-example-l4-frontend:latest AS l4_frontend_runtime
COPY --from=l3_frontend_build /app/services/guest/reservation-app/dist /usr/share/nginx/html
COPY services/guest/reservation-app/.autogenerated/nginx.autogenerated.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
FROM l4_frontend_runtime AS production
FROM l4_frontend_runtime AS development


