# ---- L1: os_base (Golden L1: flisk-restaurant-example-l1:latest) ----
FROM flisk-restaurant-example-l1:latest AS l1_os_base
# OS dependencies pre-installed in golden L1 image
WORKDIR /app


# ---- L1: runtime_env ----
# Shared runtime environment
ENV NODE_ENV=production
ENV BUN_INSTALL_CACHE_DIR=/cache/bun


# ---- L2: dependency_manifest ----
FROM flisk-restaurant-example-l2:latest AS l2_deps_manifest
WORKDIR /app

# Cache-busting mechanism - change this value to force dependency reinstall
ARG CACHE_BUSTER=2026-06-25-v1
RUN echo "Cache buster: ${CACHE_BUSTER}"


# Copy workspace root for monorepo resolution
COPY package.json ./package.json
COPY services/guest/reservation-api/.autogenerated/.npmrc.docker.autogenerated /app/.npmrc
COPY services/guest/reservation-api/.autogenerated/bunfig.docker.autogenerated.toml /app/.bunfig.toml

# Copy service manifest files for deterministic dependency layer
WORKDIR /app/services/guest/reservation-api
COPY services/guest/reservation-api/package.json ./package.json
COPY services/guest/reservation-api/.autogenerated/.npmrc.docker.autogenerated .npmrc
COPY bun.lock* ./
COPY services/guest/reservation-api/.autogenerated/bunfig.docker.autogenerated.toml .bunfig.toml

# Diagnostics suppressed (set TILT_DEBUG=true for verbose output)
# Install dependencies (quiet by default; set TILT_DEBUG=true for verbose diagnostics)
COPY shared-platform-engineering/docker-templates/install-deps.sh /usr/local/bin/install-deps.sh
RUN --mount=type=cache,target=/cache/bun,sharing=shared chmod +x /usr/local/bin/install-deps.sh && start_ts=$(date +%s) && /usr/local/bin/install-deps.sh && end_ts=$(date +%s) && echo "install-deps duration: $((end_ts-start_ts))s"
RUN mkdir -p /app/node_modules/.bun


# ---- L3: backend_compiler ----
FROM flisk-restaurant-example-l3-backend:latest AS l3_backend_build
WORKDIR /app/services/guest/reservation-api
# Build argument to skip Infisical setup (for local dev / fast builds)
ARG SKIP_INFISICAL_SETUP=0
# Reuse resolved dependencies from l2_deps_manifest to avoid reinstalling in L3
COPY --link --from=l2_deps_manifest /app/services/guest/reservation-api/node_modules ./node_modules
# Bun isolated linker symlinks may resolve through /app/node_modules/.bun
COPY --link --from=l2_deps_manifest /app/node_modules/.bun /app/node_modules/.bun
# Copy manifest files for dependency installation (in case L2 is stale)
COPY services/guest/reservation-api/package.json ./package.json
COPY services/guest/reservation-api/.autogenerated/bunfig.docker.autogenerated.toml ./bunfig.toml
COPY services/guest/reservation-api/.autogenerated/.npmrc.docker.autogenerated ./.npmrc
COPY services/guest/reservation-api/.autogenerated/tsconfig.docker.autogenerated.json ./tsconfig.json
COPY services/guest/reservation-api/.autogenerated/tsconfig.autogenerated.json ./.autogenerated/tsconfig.autogenerated.json
COPY services/guest/reservation-api/.autogenerated/*.ts ./.autogenerated/
COPY services/guest/reservation-api/src ./src
ENV NODE_ENV=production
RUN bun run build
# Fix hono/cors subpath import for Bun runtime compatibility
RUN find ./dist -type f -name "*.js" -exec sed -i "s|from 'hono/cors'|from '../node_modules/hono/dist/middleware/cors/index.js'|g" {} + || true


# ---- L3: production_purger ----
FROM flisk-restaurant-example-l2:latest AS l3_production_purger
WORKDIR /app/services/guest/reservation-api
COPY services/guest/reservation-api/package.json ./package.json
COPY services/guest/reservation-api/.autogenerated/bunfig.docker.autogenerated.toml ./bunfig.toml
COPY services/guest/reservation-api/.autogenerated/.npmrc.docker.autogenerated ./.npmrc
RUN --mount=type=cache,target=/cache/bun,sharing=shared bun install --production --cache-dir=/cache/bun
# Option 2: Aggressive node_modules pruning to reduce size
# NOTE: Keep .d.ts files - they are needed for Bun module resolution with subpath exports
RUN find node_modules -type f \( -name '*.md' -o -name '*.ts' ! -name '*.d.ts' -o -name '*.map' -o -name '*.test.js' -o -name '*.spec.js' -o -name 'README*' -o -name 'CHANGELOG*' -o -name 'LICENSE*' \) -delete
RUN find node_modules -type d \( -name '.bin' -o -name 'test' -o -name 'tests' -o -name '__tests__' -o -name 'spec' -o -name 'specs' -o -name '.github' -o -name 'docs' -o -name 'examples' \) -exec rm -rf {} + 2>/dev/null || true


# ---- L4: backend_runtime ----
FROM flisk-restaurant-example-l4-backend:latest AS l4_backend_runtime
WORKDIR /app/services/guest/reservation-api
# Build argument to skip Infisical setup (for local dev / fast builds)
ARG SKIP_INFISICAL_SETUP=0
ENV NODE_ENV=production
COPY --from=l3_production_purger /app/services/guest/reservation-api/node_modules ./node_modules
COPY --from=l3_production_purger /app/services/guest/reservation-api/node_modules/.bun /app/node_modules/.bun
COPY --from=l3_backend_build /app/services/guest/reservation-api/dist ./dist
COPY services/guest/reservation-api/package.json ./package.json
# Fix Bun hoisted package symlinks that break when copied to Docker
USER root
COPY shared-platform-engineering/docker-templates/bun-hoisted-symlink-fix.sh /usr/local/bin/bun-hoisted-symlink-fix.sh
RUN chmod +x /usr/local/bin/bun-hoisted-symlink-fix.sh && /usr/local/bin/bun-hoisted-symlink-fix.sh
USER bun
EXPOSE 4000
COPY --chmod=0755 shared-platform-engineering/docker-templates/infisical-entrypoint.sh /entrypoint.sh
ENV RESOURCE_NAME="reservation-api"
ENV INFISICAL_SECRET_PATH="/services/reservation-api"
ENV INFISICAL_TOKEN=${INFISICAL_TOKEN:-}
ENV INFISICAL_CLIENT_ID=${INFISICAL_CLIENT_ID:-}
ENV INFISICAL_CLIENT_SECRET=${INFISICAL_CLIENT_SECRET:-}
ENV INFISICAL_API_URL=${INFISICAL_API_URL:-http://infisical:8080}
ENV INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID:-}
ENV INFISICAL_ENVIRONMENT=${INFISICAL_ENVIRONMENT:-dev}
ENV INFISICAL_ALLOW_FALLBACK=${INFISICAL_ALLOW_FALLBACK:-true}
ENV RESOURCE_NAME=reservation-api
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bun", "run", "start"]

FROM l4_backend_runtime AS production
FROM l4_backend_runtime AS development


